# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================================
# TRIGGER.DEV
# ============================================================
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# RESEND (EMAIL)
# ============================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================================================
# GOOGLE CLOUD / VERTEX AI
# ============================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Gemini document extraction and Document AI OCR are restricted to Mumbai.
VERTEX_DOCUMENT_LOCATION=asia-south1
DOCUMENT_AI_LOCATION=asia-south1
DOCUMENT_AI_OCR_PROCESSOR_ID=your-enterprise-ocr-processor-id
# Optional: pin an approved processor version after representative-corpus evaluation.
DOCUMENT_AI_OCR_PROCESSOR_VERSION=
# Keep embeddings independently configured; this release permits Mumbai only.
VERTEX_EMBEDDING_LOCATION=asia-south1
# Paste the ENTIRE content of your service account JSON key here (minified to one line)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_APP_URL=https://yourdomain.com
