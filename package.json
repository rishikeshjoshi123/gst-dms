{
  "name": "gst-dms",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:assignment": "tsx --test src/lib/actions/assignment.test.ts",
    "test:metadata": "tsx --test src/lib/document-metadata.test.ts",
    "test:search-baseline": "tsx scripts/search/evaluate-legacy-search-baseline.ts",
    "test:ocr-acquisition-benchmark": "tsx --test scripts/document-ai/ocr-acquisition-benchmark.test.ts",
    "test:db:migrations": "node --test scripts/check-supabase-migrations.test.mjs",
    "test:db:types": "node --test scripts/refine-supabase-types.test.mjs",
    "test:runtime-contract": "node --test scripts/runtime-contract.test.mjs",
    "test:pilot-release-preflight": "tsx --test src/lib/pilot-release-manifest.test.ts src/lib/pilot-release-preflight.test.ts src/lib/pilot-release-policy.test.ts src/lib/public-organisation-creation.test.ts",
    "preflight:pilot-release:local": "tsx scripts/pilot-release-preflight.ts --local",
    "preflight:pilot-release": "tsx scripts/pilot-release-preflight.ts",
    "acceptance:db": "sh scripts/acceptance/local-fixtures.sh",
    "acceptance:smoke": "playwright test tests/acceptance/matter-workbench.spec.ts",
    "acceptance:onboarding": "node scripts/acceptance/run-onboarding-confirmation.mjs",
    "acceptance:team-invitations": "node scripts/acceptance/run-team-invitations.mjs --types --browser",
    "acceptance:local": "node scripts/acceptance/run-local.mjs",
    "acceptance:review": "node scripts/acceptance/run-review.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "trigger:dev": "npx trigger.dev@latest dev",
    "db:migrations:check": "node scripts/check-supabase-migrations.mjs",
    "db:types": "node scripts/generate-supabase-types.mjs",
    "db:types:local": "node scripts/generate-supabase-types.mjs --local",
    "db:types:refine": "node scripts/refine-supabase-types.mjs src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@google/genai": "^1.52.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-toast": "^1.2.17",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/typography": "^0.5.20",
    "@trigger.dev/sdk": "4.5.16",
    "@xyflow/react": "^12.0.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "pdf-lib": "1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "resend": "^6.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
