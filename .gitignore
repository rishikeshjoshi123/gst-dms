# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/project-portal/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.example, ignore everything else
.env
.env.local
.env.development
.env.production
.env.staging

# supabase local dev
/supabase/.temp/
/supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# trigger.dev local build artifacts
/.trigger/tmp/
/.trigger/active-runs.json
/.trigger/dev.lock
/.trigger/watchdog.pid

# test/scratch scripts
src/lib/ai/test-*.ts
